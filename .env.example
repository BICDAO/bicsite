# Postgres (Prisma Postgres in prod: pooled URL here)
DATABASE_URL=postgres://user@127.0.0.1:5432/bicsite
# optional: direct (non-pooled) URL, used only for migrations by `pnpm run ci`
DIRECT_URL=
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# optional: Vercel Blob media storage (falls back to local /media)
BLOB_READ_WRITE_TOKEN=
# optional: enables WalletConnect (browser wallets work without it)
NEXT_PUBLIC_WC_PROJECT_ID=
# optional: transactional email (password resets). Without it Payload logs the subject and
# discards the message, so "Forgot password" silently does nothing.
RESEND_API_KEY=
# optional: overrides the sender. Must be on a domain verified in Resend.
EMAIL_FROM=noreply@mail.bureauofinternetculture.art
EMAIL_FROM_NAME=Bureau of Internet Culture

# --- /migrate (NFD -> BIC) -------------------------------------------------
# Preview and development only. A PRODUCTION build ignores this pair entirely
# and goes live only when KNOWN_HOOK/KNOWN_BIC are set in src/lib/migration.mjs
# by a reviewed pull request. Set both or neither.
NEXT_PUBLIC_MIGRATOR_HOOK=
NEXT_PUBLIC_BIC_TOKEN=
# The kill switch. `1` takes the wallet controls off the page everywhere,
# including production, without a code change.
NEXT_PUBLIC_MIGRATION_DISABLED=
# optional: a domain-allowlisted mainnet RPC, tried before the public nodes
NEXT_PUBLIC_ETH_RPC=
